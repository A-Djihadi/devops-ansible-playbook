---
# Exemple de fichier vault — NE CONTIENT PAS de vrais secrets.
# Copier en vault/secrets.yml, remplir les valeurs, puis chiffrer :
#   ansible-vault encrypt vault/secrets.yml

vault_registry_token: "ghp_your_token_here"
# vault_registry_token est consommé par le rôle app-deploy pour `docker_login`
# vers GHCR (roles/app-deploy/tasks/main.yml). Un token GHCR (read:packages)
# est requis pour tirer les images privées.
vault_db_password: "your_database_password_here"
vault_app_secret_key: "your_secret_key_here"
