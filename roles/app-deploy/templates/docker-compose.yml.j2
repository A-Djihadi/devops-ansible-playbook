version: "3.9"
# Généré par Ansible — ne pas éditer manuellement sur le serveur

services:
  app:
    image: ghcr.io/a-djihadi/myapp:{{ app_image_tag | default('latest') }}
    container_name: myapp
    ports:
      - "{{ app_port }}:8080"
    restart: unless-stopped
    environment:
      APP_ENV: production

networks:
  default:
    name: myapp-network
